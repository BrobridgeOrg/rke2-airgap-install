# ── Bundle ────────────────────────────────────────────────────────────────────
RKE2_VERSION=v1.35.4+rke2r1

# auto-detected from uname -m (x86_64 → amd64, aarch64 → arm64); set to override
# ARCH=amd64

OUT_DIR=output

# default: https://github.com/rancher/rke2/releases/download
ARTIFACTS_BASE_URL=

# auto-detected from build machine /etc/os-release (ubuntu/debian → ubuntu, others → rhel)
# options: rhel | ubuntu
TARGET_OS=

# ── RPM repo (RHEL/CentOS only) ───────────────────────────────────────────────

# auto-detected from /etc/os-release VERSION_ID; set to override
LINUX_MAJOR=

# ── Node (auto-detected if empty) ─────────────────────────────────────────────

# auto-generated on first run and written back here
TOKEN=

# auto-detected from hostname -s
NODE_NAME=

# auto-detected from primary route (ip route get 1.1.1.1)
NODE_IP=

# ── Networking ────────────────────────────────────────────────────────────────

# options: canal | cilium | calico | none
CNI=canal

# options: traefik | nginx | none
INGRESS=traefik

# extra SANs appended to NODE_NAME and NODE_IP, e.g. "vip.example.com 10.0.0.100"
TLS_SANS=

# ── Security ──────────────────────────────────────────────────────────────────

# enable CIS hardening profile
CIS=true

# ── Advanced (server only) ────────────────────────────────────────────────────

# false: add CriticalAddonsOnly=true:NoExecute taint (dedicated control plane)
SCHEDULABLE=true

DISABLE_CLOUD_CONTROLLER=true

# recommended when using Cilium
DISABLE_KUBE_PROXY=false

# true: set system-default-registry to registry.rancher.com
RANCHER_PRIME=false

# timezone injected into kube component env vars
TIMEZONE=Asia/Taipei
